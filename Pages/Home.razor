@code {
    private readonly List<OutputLine> _demoOutput = [];
    private bool _running;

    private record OutputLine(string Text, string Css);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("highlightCode");
    }

    private async Task RunDemo()
    {
        _running = true;
        _demoOutput.Clear();
        StateHasChanged();

        var results = await Observable.Range(1, 20)
            .Where(n => n % 2 == 0)
            .Select(n => n * n)
            .ToList();

        foreach (var v in results)
            _demoOutput.Add(new($"Next: {v}", "value"));

        _demoOutput.Add(new("Completed ✓", "complete"));
        _running = false;
        StateHasChanged();
    }

    private void ClearDemo()
    {
        _demoOutput.Clear();
        StateHasChanged();
    }
}

