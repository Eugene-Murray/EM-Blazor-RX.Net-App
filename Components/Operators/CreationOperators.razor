<!-- ── Range ──────────────────────────────────────────────────────── -->
<div class="operator-card">
<div class="operator-card-header">
<span class="tag tag-creation">Creation</span>
<span class="operator-name">Range</span>
</div>
<p class="operator-desc">
Emits a contiguous sequence of integers starting at <em>start</em> for
<em>count</em> values, synchronously, then completes.
</p>
<div class="code-block">
<div class="code-block-header">
<span class="code-lang-badge">C#</span>
<span>Integer sequence — synchronous</span>
</div>
<pre><code class="language-csharp">// Basic range: 1, 2, 3, 4, 5
Observable.Range(1, 5)
  .Subscribe(Console.WriteLine);

// Combine with operators immediately
Observable.Range(1, 10)
  .Where(n =&gt; n % 2 == 0)
  .Select(n =&gt; n * n)
  .Subscribe(n =&gt; Console.WriteLine($"Even square: {n}"));
// 4, 16, 36, 64, 100

// Sum using Scan (running total)
Observable.Range(1, 5)
  .Scan(0, (acc, n) =&gt; acc + n)
  .Subscribe(sum =&gt; Console.WriteLine($"Running sum: {sum}"));
// 1, 3, 6, 10, 15</code></pre>
</div>
