<!-- ── FromAsync ──────────────────────────────────────────────────── -->
<div class="operator-card">
<div class="operator-card-header">
<span class="tag tag-creation">Creation</span>
<span class="operator-name">FromAsync</span>
</div>
<p class="operator-desc">
Wraps a <code>Task</code> or <code>Task&lt;T&gt;</code> into a cold observable —
the task starts only when someone subscribes. The bridge between async/await
and the Rx world.
</p>
<div class="code-block">
<div class="code-block-header">
<span class="code-lang-badge">C#</span>
<span>Task → cold observable (lazy, cancellable)</span>
</div>
<pre><code class="language-csharp">// Wrap an async method — task runs on subscribe
IObservable&lt;string&gt; obs = Observable.FromAsync(async ct =&gt;
{
await Task.Delay(500, ct);     // ct honours unsubscription
return "Hello from async!";
});

obs.Subscribe(Console.WriteLine); // task starts NOW
obs.Subscribe(Console.WriteLine); // second subscribe = second task run

// Compose like any observable
Observable.FromAsync(() =&gt; httpClient.GetStringAsync("/api/data"))
  .Select(json =&gt; JsonSerializer.Deserialize&lt;MyModel&gt;(json))
  .Subscribe(model =&gt; UpdateUI(model));

// Use with SelectMany for per-item async work
Observable.Range(1, 3)
  .SelectMany(id =&gt; Observable.FromAsync(() =&gt; FetchUser(id)))
  .Subscribe(Console.WriteLine);</code></pre>
</div>
