<!-- ── Create ─────────────────────────────────────────────────────── -->
<div class="operator-card">
<div class="operator-card-header">
<span class="tag tag-creation">Creation</span>
<span class="operator-name">Create</span>
</div>
<p class="operator-desc">
The escape hatch — build any observable from scratch by calling
<code>OnNext</code>, <code>OnError</code>, and <code>OnCompleted</code>
manually. Return a disposable for clean-up on unsubscription.
</p>
<div class="code-block">
<div class="code-block-header">
<span class="code-lang-badge">C#</span>
<span>Full manual control over the observable contract</span>
</div>
<pre><code class="language-csharp">IObservable&lt;int&gt; myObs = Observable.Create&lt;int&gt;(observer =&gt;
{
observer.OnNext(1);
observer.OnNext(2);

// Could conditionally call OnError instead:
// observer.OnError(new Exception("oops"));

observer.OnNext(3);
observer.OnCompleted();

// Return cleanup action (called on Dispose / unsubscription)
return Disposable.Create(() =&gt; Console.WriteLine("Unsubscribed"));
});

myObs.Subscribe(
v  =&gt; Console.WriteLine($"Next: {v}"),
ex =&gt; Console.WriteLine($"Error: {ex.Message}"),
() =&gt; Console.WriteLine("Completed"));

// Async variant — great for bridging event-based APIs
IObservable&lt;string&gt; fromEvents = Observable.Create&lt;string&gt;(async observer =&gt;
{
await Task.Delay(100);
observer.OnNext("Event arrived");
observer.OnCompleted();
});</code></pre>
</div>
