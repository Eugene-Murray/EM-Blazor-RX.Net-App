<!-- ── Empty / Never / Throw ──────────────────────────────────────── -->
<div class="operator-card">
<div class="operator-card-header">
<span class="tag tag-creation">Creation</span>
<span class="operator-name">Empty / Never / Throw</span>
</div>
<p class="operator-desc">
Three degenerate observables useful as building blocks:
<code>Empty</code> completes immediately, <code>Never</code> never terminates,
and <code>Throw</code> immediately errors.
</p>
<div class="code-block">
<div class="code-block-header">
<span class="code-lang-badge">C#</span>
<span>Degenerate observables — useful as defaults and tests</span>
</div>
<pre><code class="language-csharp">// Empty — completes with no values
Observable.Empty&lt;int&gt;()
  .Subscribe(
  _ =&gt; Console.WriteLine("Never called"),
  () =&gt; Console.WriteLine("Empty completed"));

// Never — infinite, never completes or errors
// Use with Timeout or TakeUntil in real code
var never = Observable.Never&lt;int&gt;();

// Throw — immediately calls OnError
Observable.Throw&lt;int&gt;(new Exception("Boom!"))
  .Subscribe(
  _ =&gt; Console.WriteLine("Never called"),
  ex  =&gt; Console.WriteLine($"Error: {ex.Message}"),
  () =&gt; Console.WriteLine("Never called"));

// Common pattern: use Empty as a safe Catch fallback
someObservable.Catch&lt;int, Exception&gt;(_ =&gt; Observable.Empty&lt;int&gt;());</code></pre>
</div>
