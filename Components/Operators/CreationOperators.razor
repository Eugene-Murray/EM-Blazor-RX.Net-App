@inject IJSRuntime JS
@implements IDisposable

<div class="section-title">
<span class="tag tag-creation">Creation</span> Creating Observables
</div>

<div class="info-box note">
<span class="info-box-icon">💡</span>
<div class="info-box-content">
<p>
Creation operators are the entry points of any Rx.NET pipeline — they produce the
observable sequences that all other operators transform. Choose the right factory
based on whether your data is synchronous, time-based, or pulled from an async source.
</p>
</div>
</div>

<div class="operator-grid">

<!-- ── Return / Just ──────────────────────────────────────────────── -->
<div class="operator-card">
<div class="operator-card-header">
<span class="tag tag-creation">Creation</span>
<span class="operator-name">Return / Just</span>
</div>
<p class="operator-desc">
Emits a <em>single</em> value synchronously, then completes.
The simplest way to lift a plain value into the observable world.
</p>
<div class="code-block">
<div class="code-block-header">
<span class="code-lang-badge">C#</span>
<span>Single value → complete</span>
</div>
<pre><code class="language-csharp">// Emit one value then complete
IObservable&lt;int&gt; single = Observable.Return(42);
single.Subscribe(
v  =&gt; Console.WriteLine($"Next:      {v}"),
() =&gt; Console.WriteLine("Completed"));
// Next: 42
// Completed

// Useful as a default / fallback observable
IObservable&lt;string&gt; fallback = Observable.Return("default value");

// Works with any type
Observable.Return(DateTime.UtcNow)
  .Subscribe(d =&gt; Console.WriteLine(d));</code></pre>
</div>
