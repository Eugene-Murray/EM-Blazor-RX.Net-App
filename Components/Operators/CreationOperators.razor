<!-- ── Defer ──────────────────────────────────────────────────────── -->
<div class="operator-card">
<div class="operator-card-header">
<span class="tag tag-creation">Creation</span>
<span class="operator-name">Defer</span>
</div>
<p class="operator-desc">
Delays observable creation until subscription time — each subscriber gets a
<em>freshly created</em> observable. Useful when the factory depends on
state that changes between subscriptions.
</p>
<div class="code-block">
<div class="code-block-header">
<span class="code-lang-badge">C#</span>
<span>Fresh observable per subscription — captures state at subscribe time</span>
</div>
<pre><code class="language-csharp">// Without Defer: timestamp captured ONCE at creation time
var eager = Observable.Return(DateTime.UtcNow);

// With Defer: timestamp captured fresh on EACH subscription
var lazy = Observable.Defer(() =&gt; Observable.Return(DateTime.UtcNow));

eager.Subscribe(t =&gt; Console.WriteLine($"Eager: {t:HH:mm:ss.fff}"));
await Task.Delay(500);
eager.Subscribe(t =&gt; Console.WriteLine($"Eager: {t:HH:mm:ss.fff}")); // same!

lazy.Subscribe(t =&gt; Console.WriteLine($"Lazy:  {t:HH:mm:ss.fff}"));
await Task.Delay(500);
lazy.Subscribe(t =&gt; Console.WriteLine($"Lazy:  {t:HH:mm:ss.fff}")); // different!

// Practical use: defer reading volatile config/state
var deferred = Observable.Defer(() =&gt;
Observable.FromAsync(() =&gt; FetchWithCurrentToken(authToken)));</code></pre>
</div>
