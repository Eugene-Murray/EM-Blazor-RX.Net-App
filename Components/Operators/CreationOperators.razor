<!-- ── Timer ──────────────────────────────────────────────────────── -->
<div class="operator-card">
<div class="operator-card-header">
<span class="tag tag-creation">Creation</span>
<span class="operator-name">Timer</span>
</div>
<p class="operator-desc">
Fires after an initial <em>due time</em>, optionally continuing with a fixed
period — giving you a delayed single-shot or a delayed interval.
</p>
<div class="code-block">
<div class="code-block-header">
<span class="code-lang-badge">C#</span>
<span>Delayed fire — one-shot or periodic</span>
</div>
<pre><code class="language-csharp">// One-shot: fires once after 2 seconds
Observable.Timer(TimeSpan.FromSeconds(2))
  .Subscribe(_ =&gt; Console.WriteLine("Fired after 2s"));

// Periodic: start after 1s, then every 500ms
Observable.Timer(
TimeSpan.FromSeconds(1),
TimeSpan.FromMilliseconds(500))
.Take(4)
.Subscribe(tick =&gt; Console.WriteLine($"Tick {tick}"));

// Useful for delayed retries / back-off
var delayed = Observable.Timer(TimeSpan.FromMilliseconds(500))
.SelectMany(_ =&gt; FetchData());</code></pre>
</div>
