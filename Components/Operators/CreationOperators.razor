<!-- ── Interval ───────────────────────────────────────────────────── -->
<div class="operator-card">
<div class="operator-card-header">
<span class="tag tag-creation">Creation</span>
<span class="operator-name">Interval</span>
</div>
<p class="operator-desc">
Emits an ever-increasing <code>long</code> (0, 1, 2 …) at a fixed cadence,
indefinitely. Add <code>Take</code> to limit it. The backbone of polling
and animation loops.
</p>
<div class="code-block">
<div class="code-block-header">
<span class="code-lang-badge">C#</span>
<span>Tick every N ms — infinite hot-ish sequence</span>
</div>
<pre><code class="language-csharp">// Tick every 500 ms; take first 6 ticks
IDisposable sub = Observable
.Interval(TimeSpan.FromMilliseconds(500))
.Take(6)
.Subscribe(
tick =&gt; Console.WriteLine($"Tick {tick}"),
()   =&gt; Console.WriteLine("Done"));

// Always dispose when the component is destroyed!
// protected override void Dispose() =&gt; sub.Dispose();

// Combine with Select to produce meaningful values
Observable.Interval(TimeSpan.FromSeconds(1))
  .Select(i =&gt; DateTime.UtcNow.ToString("HH:mm:ss"))
  .Take(5)
  .Subscribe(Console.WriteLine);</code></pre>
</div>
