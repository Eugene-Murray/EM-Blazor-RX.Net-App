@code {
// ── Shared helpers ────────────────────────────────────────────────────────
private record OutputLine(string Text, string Css);

private RenderFragment ConsoleBody(List<OutputLine> lines) => builder =>
{
if (lines.Count == 0)
{
builder.OpenElement(0, "div");
builder.AddAttribute(1, "class", "output-empty");
builder.AddContent(2, "Press Run to execute…");
builder.CloseElement();
}
else
{
int seq = 0;
foreach (var line in lines)
{
builder.OpenElement(seq++, "div");
builder.AddAttribute(seq++, "class", $"output-line {line.Css}");
builder.OpenElement(seq++, "span");
builder.AddAttribute(seq++, "class", "output-prompt");
builder.AddContent(seq++, "›");
builder.CloseElement();
builder.OpenElement(seq++, "span");
builder.AddContent(seq++, line.Text);
builder.CloseElement();
builder.CloseElement();
}
}
};

private void ClearOutput(List<OutputLine> list) { list.Clear(); StateHasChanged(); }

private void Add(List<OutputLine> list, string text, string css = "value")
{
list.Add(new(text, css));
StateHasChanged();
}

// ── Return ────────────────────────────────────────────────────────────────
private readonly List<OutputLine> _returnOut = [];
private bool _returnRunning;

private async Task RunReturn()
{
_returnRunning = true;
_returnOut.Clear();
StateHasChanged();

Add(_returnOut, "— Observable.Return(42) —", "info");
Observable.Return(42).Subscribe(
v  => Add(_returnOut, $"Next: {v}"),
() => Add(_returnOut, "Completed ✓", "complete"));

await Task.Delay(50);

Add(_returnOut, "— Observable.Return(DateTime.UtcNow) —", "info");
Observable.Return(DateTime.UtcNow).Subscribe(
v  => Add(_returnOut, $"Next: {v:HH:mm:ss.fff} UTC"),
() => Add(_returnOut, "Completed ✓", "complete"));

await Task.Delay(50);

Add(_returnOut, "— Observable.Return(\"fallback\") —", "info");
Observable.Return("fallback value").Subscribe(
v  => Add(_returnOut, $"Next: {v}"),
() => Add(_returnOut, "Completed ✓", "complete"));

_returnRunning = false;
StateHasChanged();
}

// ── Range ─────────────────────────────────────────────────────────────────
private readonly List<OutputLine> _rangeOut = [];
private bool _rangeRunning;

private async Task RunRange()
{
_rangeRunning = true;
_rangeOut.Clear();
StateHasChanged();

Add(_rangeOut, "— Observable.Range(1, 5) —", "info");
await Observable.Range(1, 5)
.Do(v => Add(_rangeOut, $"Next: {v}"))
.ToList();
Add(_rangeOut, "Completed ✓", "complete");

Add(_rangeOut, "— Range(1,10).Where(even).Select(n²) —", "info");
await Observable.Range(1, 10)
.Where(n => n % 2 == 0)
.Select(n => n * n)
.Do(v => Add(_rangeOut, $"Even square: {v}"))
.ToList();

Add(_rangeOut, "— Range(1,5).Scan(running sum) —", "info");
await Observable.Range(1, 5)
.Scan(0, (acc, n) => acc + n)
.Do(v => Add(_rangeOut, $"Running sum: {v}"))
.ToList();
Add(_rangeOut, "All demos completed ✓", "complete");

_rangeRunning = false;
StateHasChanged();
}

// ── Empty / Never / Throw ─────────────────────────────────────────────────
private readonly List<OutputLine> _entOut = [];
private bool _entRunning;

private async Task RunEmptyNeverThrow()
{
_entRunning = true;
_entOut.Clear();
StateHasChanged();

Add(_entOut, "— Observable.Empty<int>() —", "info");
Observable.Empty<int>().Subscribe(
_ => Add(_entOut, "OnNext (never called)"),
() => Add(_entOut, "Completed immediately ✓", "complete"));

await Task.Delay(50);

Add(_entOut, "— Observable.Never<int>() (with 300ms Timeout) —", "info");
try
{
await Observable.Never<int>()
.Timeout(TimeSpan.FromMilliseconds(300))
.ToList();
}
catch (TimeoutException)
{
Add(_entOut, "Never timed out as expected ✓", "complete");
}

Add(_entOut, "— Observable.Throw<int>(ex) —", "info");
Observable.Throw<int>(new InvalidOperationException("Boom!")).Subscribe(
_ => Add(_entOut, "OnNext (never called)"),
ex => Add(_entOut, $"OnError: {ex.Message} ✓", "complete"),
() => Add(_entOut, "OnCompleted (never called)"));

_entRunning = false;
StateHasChanged();
}

// ── Interval ──────────────────────────────────────────────────────────────
private readonly List<OutputLine> _intervalOut = [];
private bool _intervalRunning;

private async Task RunInterval()
{
_intervalRunning = true;
_intervalOut.Clear();
StateHasChanged();

Add(_intervalOut, "Interval(400 ms) × 6 ticks…", "info");

await Observable.Interval(TimeSpan.FromMilliseconds(400))
.Take(6)
.Do(tick => Add(_intervalOut, $"Tick {tick}  [{DateTime.UtcNow:HH:mm:ss.fff}]"))
.ToList();

Add(_intervalOut, "Interval completed ✓", "complete");
_intervalRunning = false;
StateHasChanged();
}

// ── Timer ─────────────────────────────────────────────────────────────────
private readonly List<OutputLine> _timerOut = [];
private bool _timerRunning;

private async Task RunTimer()
{
_timerRunning = true;
_timerOut.Clear();
StateHasChanged();

Add(_timerOut, "One-shot: Timer fires after 500 ms…", "info");
await Observable.Timer(TimeSpan.FromMilliseconds(500))
.Do(_ => Add(_timerOut, $"One-shot fired at {DateTime.UtcNow:HH:mm:ss.fff} ✓", "complete"))
.ToList();

Add(_timerOut, "Periodic: Timer(200 ms due, 300 ms period) × 4…", "info");
await Observable.Timer(
TimeSpan.FromMilliseconds(200),
TimeSpan.FromMilliseconds(300))
.Take(4)
.Do(tick => Add(_timerOut, $"Periodic tick {tick}"))
.ToList();

Add(_timerOut, "Timer completed ✓", "complete");
_timerRunning = false;
StateHasChanged();
}

// ── FromAsync ─────────────────────────────────────────────────────────────
private readonly List<OutputLine> _fromAsyncOut = [];
private bool _fromAsyncRunning;
private int  _fromAsyncCallCount;

private async Task RunFromAsync()
{
_fromAsyncRunning = true;
_fromAsyncOut.Clear();
_fromAsyncCallCount = 0;
StateHasChanged();

IObservable<string> coldObs = Observable.FromAsync(async ct =>
{
int n = ++_fromAsyncCallCount;
Add(_fromAsyncOut, $"Task #{n} started (each subscribe = new task)", "info");
await Task.Delay(300, ct);
return $"Result from task #{n}";
});

Add(_fromAsyncOut, "First subscription…", "info");
var r1 = await coldObs.FirstAsync();
Add(_fromAsyncOut, $"Sub #1 got: {r1}", "complete");

Add(_fromAsyncOut, "Second subscription…", "info");
var r2 = await coldObs.FirstAsync();
Add(_fromAsyncOut, $"Sub #2 got: {r2}", "complete");

Add(_fromAsyncOut, "SelectMany — 3 parallel async calls…", "info");
await Observable.Range(1, 3)
.SelectMany(id => Observable.FromAsync(async () =>
{
await Task.Delay(id * 80);
return $"User{id} (delay {id * 80}ms)";
}))
.Do(v => Add(_fromAsyncOut, $"Result: {v}"))
.ToList();

Add(_fromAsyncOut, "All done ✓", "complete");
_fromAsyncRunning = false;
StateHasChanged();
}

// ── Create ────────────────────────────────────────────────────────────────
private readonly List<OutputLine> _createOut = [];
private bool _createRunning;

private async Task RunCreate()
{
_createRunning = true;
_createOut.Clear();
StateHasChanged();

Add(_createOut, "— Observable.Create (sync) —", "info");
Observable.Create<int>(observer =>
{
observer.OnNext(1);
observer.OnNext(2);
observer.OnNext(3);
observer.OnCompleted();
return Disposable.Create(() => Add(_createOut, "Cleanup called on Dispose ✓", "info"));
}).Subscribe(
v  => Add(_createOut, $"Next: {v}"),
() => Add(_createOut, "Completed ✓", "complete"));

await Task.Delay(100);

Add(_createOut, "— Observable.Create (async, with error) —", "info");
await Observable.Create<string>(async observer =>
{
await Task.Delay(150);
observer.OnNext("First async value");
await Task.Delay(150);
observer.OnNext("Second async value");
observer.OnCompleted();
})
.Do(v => Add(_createOut, $"Next: {v}"))
.ToList();

Add(_createOut, "Async Create completed ✓", "complete");
_createRunning = false;
StateHasChanged();
}

// ── Defer ─────────────────────────────────────────────────────────────────
private readonly List<OutputLine> _deferOut = [];
private bool _deferRunning;

private async Task RunDefer()
{
_deferRunning = true;
_deferOut.Clear();
StateHasChanged();

// Eager: captured once at creation
var eager = Observable.Return(DateTime.UtcNow);

// Lazy: captured fresh on each subscribe
var lazy = Observable.Defer(() => Observable.Return(DateTime.UtcNow));

Add(_deferOut, "First subscribe (t=0):", "info");
eager.Subscribe(t => Add(_deferOut, $"Eager: {t:HH:mm:ss.fff}"));
lazy.Subscribe(t  => Add(_deferOut, $"Lazy:  {t:HH:mm:ss.fff}"));

Add(_deferOut, "Waiting 600 ms…", "info");
await Task.Delay(600);

Add(_deferOut, "Second subscribe (t=600ms):", "info");
eager.Subscribe(t => Add(_deferOut, $"Eager: {t:HH:mm:ss.fff}  ← same as before"));
lazy.Subscribe(t  => Add(_deferOut, $"Lazy:  {t:HH:mm:ss.fff}  ← fresh value", "complete"));

Add(_deferOut, "Defer demo completed ✓", "complete");
_deferRunning = false;
StateHasChanged();
}

// ── Generate ──────────────────────────────────────────────────────────────
private readonly List<OutputLine> _generateOut = [];
private bool _generateRunning;

private async Task RunGenerate()
{
_generateRunning = true;
_generateOut.Clear();
StateHasChanged();

Add(_generateOut, "— Squares: Generate(1, i≤5, i++, i²) —", "info");
await Observable.Generate(
initialState:   1,
condition:      i => i <= 5,
iterate:        i => i + 1,
resultSelector: i => i * i)
.Do(v => Add(_generateOut, $"Next: {v}"))
.ToList();
Add(_generateOut, "Completed ✓", "complete");

Add(_generateOut, "— Fibonacci: Generate((0,1), a<100, …) —", "info");
await Observable.Generate(
initialState:   (a: 0, b: 1),
condition:      s => s.a < 100,
iterate:        s => (s.b, s.a + s.b),
resultSelector: s => s.a)
.Do(v => Add(_generateOut, $"Fib: {v}"))
.ToList();
Add(_generateOut, "Completed ✓", "complete");

Add(_generateOut, "— Timed: Generate(0, i<5, i++, 300ms) —", "info");
await Observable.Generate(
initialState:   0,
condition:      i => i < 5,
iterate:        i => i + 1,
resultSelector: i => $"Step {i}",
timeSelector:   _ => TimeSpan.FromMilliseconds(300))
.Do(v => Add(_generateOut, v))
.ToList();
Add(_generateOut, "All Generate demos completed ✓", "complete");

_generateRunning = false;
StateHasChanged();
}

// ── Lifecycle ─────────────────────────────────────────────────────────────
protected override async Task OnAfterRenderAsync(bool firstRender)
{
if (firstRender)
await JS.InvokeVoidAsync("highlightCode");
}

public void Dispose() { /* nothing long-lived to clean up */ }
}
